# Vista previa de la web real antes de la apertura: https://.../?preview=<PREVIEW_TOKEN>
# (mínimo 16 caracteres; se configura en Netlify → Environment variables)
PREVIEW_TOKEN=

# Google Calendar (cuenta de servicio) — backend de reservas
GOOGLE_SA_EMAIL=
GOOGLE_SA_KEY=
CALENDAR_ID=

# Aviso de nueva reserva al propietario por WhatsApp (CallMeBot, MVP)
OWNER_WHATSAPP=
CALLMEBOT_KEY=
