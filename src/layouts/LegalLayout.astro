---
import "../styles/global.css";
import { site } from "../config/site.ts";
import SEO from "../components/SEO.astro";
import Marca from "../components/Marca.astro";

interface Props {
	titulo: string;
}

const { titulo } = Astro.props;
---

<html lang="es">
	<head>
		<!-- noindex mientras el contenido legal sea provisional -->
		<SEO titulo={`${titulo} · ${site.nombre}`} descripcion={`${titulo} de ${site.nombre}, Parla (Madrid).`} noindex />
	</head>
	<body class="min-h-screen bg-[var(--color-noche)] px-6 py-16 text-gray-300 lg:px-10">
		<div class="mx-auto max-w-2xl">
			<Marca class="mb-10 inline-flex" />

			<h1 class="neon-text mb-6 [font-family:var(--font-titular)] text-3xl text-[var(--color-neon-cian)] lg:text-4xl">
				{titulo}
			</h1>

			<div class="space-y-4 text-sm leading-relaxed text-gray-400 [&_a]:underline [&_a]:underline-offset-2 [&_h2]:mt-6 [&_h2]:text-base [&_h2]:font-semibold [&_h2]:text-gray-200">
				<slot />
			</div>

			<a href="/" class="mt-10 inline-block text-sm text-gray-500 underline underline-offset-4">Volver al inicio</a>
		</div>
	</body>
</html>
