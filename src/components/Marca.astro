---
// Wordmark tipográfico "Taberna / SIGLO XXI" (sustituye a la antigua píldora con corona).
import { site } from "../config/site.ts";

interface Props {
	href?: string;
	class?: string;
}

const { href = "/", class: className = "" } = Astro.props;
---

<a href={href} aria-label={`${site.nombre}, ir al inicio`} class:list={["flex flex-col leading-none text-[var(--color-neon-oro)]", className]}>
	<span class="[font-family:var(--font-acento)] text-lg italic">Taberna</span>
	<span class="-mt-0.5 text-sm font-bold uppercase tracking-[0.35em]">Siglo XXI</span>
</a>
