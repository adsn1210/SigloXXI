---
// <head> común: título, descripción, canonical, Open Graph, Twitter, favicons y JSON-LD.
import { site } from "../config/site.ts";

interface Props {
	titulo?: string;
	descripcion?: string;
	/** Ruta canónica (por defecto, la de la petición) */
	ruta?: string;
	/** Páginas provisionales o internas: no indexar */
	noindex?: boolean;
	/** Añade los datos estructurados del local (BarOrPub) */
	datosLocal?: boolean;
}

const {
	titulo = site.seo.titulo,
	descripcion = site.seo.descripcion,
	ruta = Astro.url.pathname,
	noindex = false,
	datosLocal = false,
} = Astro.props;

const canonical = new URL(ruta, site.url).href;
const imagen = new URL(site.seo.imagen, site.url).href;

const [apertura, cierre] = [site.horario.apertura, site.horario.cierre];
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BarOrPub",
	"@id": `${site.url}/#local`,
	name: site.nombre,
	slogan: site.eslogan,
	description: site.seo.descripcion,
	url: site.url,
	image: imagen,
	telephone: site.contacto.telefonoInternacional,
	servesCuisine: "Tapas",
	acceptsReservations: true,
	address: {
		"@type": "PostalAddress",
		streetAddress: site.direccion.calle,
		addressLocality: site.direccion.municipio,
		addressRegion: site.direccion.provincia,
		addressCountry: site.direccion.pais,
	},
	hasMap: site.direccion.mapsUrl,
	openingHoursSpecification: [
		{
			"@type": "OpeningHoursSpecification",
			dayOfWeek: site.horario.diasSchema,
			opens: apertura,
			closes: cierre,
		},
	],
	sameAs: [site.instagramUrl],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{titulo}</title>
<meta name="description" content={descripcion} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta name="theme-color" content={site.seo.colorTema} />
<meta name="generator" content={Astro.generator} />

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<meta property="og:type" content="website" />
<meta property="og:locale" content="es_ES" />
<meta property="og:site_name" content={site.nombre} />
<meta property="og:title" content={titulo} />
<meta property="og:description" content={descripcion} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imagen} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={site.seo.imagenAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={titulo} />
<meta name="twitter:description" content={descripcion} />
<meta name="twitter:image" content={imagen} />

{datosLocal && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
