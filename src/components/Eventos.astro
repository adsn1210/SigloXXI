---
import { Image } from "astro:assets";
import { site } from "../config/site.ts";
import NeonIcon from "./NeonIcon.astro";
import blob from "../assets/decor/blob-neon.jpg";
import muralFrases from "../assets/fotos/mural-frases.jpg";

const iconos = {
	calendario: "screen",
	ubicacion: "crown",
} as const;

const { dj, cumpleanos } = site.eventos;
const djWhatsappUrl = `${site.contacto.whatsappUrl}?text=${encodeURIComponent(dj.whatsappTexto)}`;
---

<section id="eventos" class="relative overflow-hidden px-6 py-20 lg:px-10 lg:py-28">
	<Image
		src={blob}
		alt=""
		role="presentation"
		width={900}
		height={900}
		class="pointer-events-none absolute -right-32 -bottom-32 w-[30rem] opacity-15 mix-blend-screen blur-2xl"
	/>

	<div class="relative mx-auto max-w-5xl">
		<h2 class="neon-text mb-3 [font-family:var(--font-titular)] text-3xl tracking-wide text-[var(--color-neon-rosa)] lg:text-5xl">
			Celebra con nosotros
		</h2>
		<p class="mb-10 text-sm uppercase tracking-[0.2em] text-gray-400">
			{site.eventos.tipos.join(" · ")}
		</p>

		<div class="grid gap-6 lg:grid-cols-5">
			<!-- Sesiones de DJ: protagonista de la sección -->
			<article class="neon-box relative isolate flex min-h-[26rem] flex-col justify-end overflow-hidden rounded-lg p-7 lg:col-span-3 lg:p-10">
				<Image
					src={muralFrases}
					alt=""
					role="presentation"
					widths={[480, 768, 1024]}
					sizes="(min-width: 1024px) 600px, 100vw"
					class="absolute inset-0 -z-10 h-full w-full object-cover"
				/>
				<div class="absolute inset-0 -z-10 bg-gradient-to-t from-[var(--color-noche)] via-[var(--color-noche)]/85 to-[var(--color-noche)]/30"></div>

				<p class="mb-4 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.3em] text-[var(--color-neon-cian)]">
					<NeonIcon name="vinyl" class="h-6 w-6" />
					{dj.etiqueta}
				</p>
				<h3 class="neon-text mb-4 [font-family:var(--font-titular)] text-3xl font-bold leading-tight text-white lg:text-4xl">
					{dj.titulo}
				</h3>
				<p class="mb-7 max-w-md text-base leading-relaxed text-gray-200">
					{dj.texto}
				</p>
				<a
					href={djWhatsappUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="neon-btn inline-flex items-center gap-2 self-start rounded-md px-6 py-3 text-sm uppercase tracking-wide"
				>
					<NeonIcon name="whatsapp" class="h-4 w-4" />
					{dj.cta}
				</a>
			</article>

			<!-- Cumpleaños -->
			<article class="acento-oro flex flex-col rounded-lg border bg-[var(--color-noche-2)]/60 p-7 lg:col-span-2 lg:p-8">
				<NeonIcon name="cake" class="mb-5 h-9 w-9 text-[var(--color-neon-oro)]" />
				<h3 class="mb-3 [font-family:var(--font-titular)] text-2xl font-bold text-[var(--color-neon-oro)] lg:text-3xl">
					{cumpleanos.titulo}
				</h3>
				<p class="mb-7 text-base leading-relaxed text-gray-300">
					{cumpleanos.texto}
				</p>

				<ul class="mb-8 space-y-3 border-t border-white/10 pt-5">
					{site.eventos.opciones.map((op) => (
						<li class="flex items-center gap-3 text-sm text-gray-300">
							<NeonIcon name={iconos[op.icono as keyof typeof iconos]} class="h-5 w-5 shrink-0 text-[var(--color-neon-violeta)]" />
							{op.titulo}
						</li>
					))}
				</ul>

				<a href="/reservas" class="neon-btn mt-auto inline-flex items-center gap-2 self-start rounded-md px-6 py-3 text-sm uppercase tracking-wide">
					<NeonIcon name="calendar" class="h-4 w-4" />
					Reservar fecha
				</a>
			</article>
		</div>

		<p class="mt-10 text-center [font-family:var(--font-acento)] text-2xl italic text-gray-300">
			Despedidas, empresa o el partido del domingo: cuéntanos qué necesitas y lo organizamos.
		</p>
	</div>
</section>
