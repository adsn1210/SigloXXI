---
// Iconos de línea (stroke, sin relleno) — cero emojis en toda la web.
export type IconName =
	| "crown"
	| "calendar"
	| "pin"
	| "whatsapp"
	| "instagram"
	| "star"
	| "menu"
	| "close"
	| "beer"
	| "cocktail"
	| "food"
	| "music"
	| "screen"
	| "vinyl"
	| "cake"
	| "arrow-left"
	| "arrow-right";

interface Props {
	name: IconName;
	class?: string;
}

const { name, class: className = "h-5 w-5" } = Astro.props;
---

{name === "crown" && (
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
		<path d="M4 17l-1.4-8.5L8 12l4-7 4 7 5.4-3.5L20 17H4z" stroke-linejoin="round" />
		<path d="M4 17h16v2.5H4z" stroke-linejoin="round" />
	</svg>
)}

{name === "calendar" && (
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
		<rect x="3" y="5" width="18" height="16" rx="2" />
		<path d="M3 10h18M8 3v4M16 3v4" />
	</svg>
)}

{name === "pin" && (
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
		<path d="M12 21s7-7.5 7-12a7 7 0 10-14 0c0 4.5 7 12 7 12z" />
		<circle cx="12" cy="9" r="2.5" />
	</svg>
)}

{/* Globo de WhatsApp en línea: círculo centrado en 12,12 con la cola abajo a la izquierda + auricular */}
{name === "whatsapp" && (
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
		<path d="M7.1 19A8.5 8.5 0 1 0 4.9 16.7L3.5 20.5z" stroke-linejoin="round" />
		<path d="M9.2 7.8c.3-.3.8-.3 1 .1l.9 1.7c.2.3.1.7-.1 1l-.6.6c.6 1.3 1.6 2.3 2.9 2.9l.6-.6c.3-.3.7-.3 1-.1l1.7.9c.4.2.4.7.1 1l-.8.8c-.6.6-1.5.7-2.3.4-2.4-1-4.3-2.9-5.3-5.3-.3-.8-.2-1.7.4-2.3z" stroke-linejoin="round" stroke-width="1.3" />
	</svg>
)}

{name === "instagram" && (
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
		<rect x="3" y="3" width="18" height="18" rx="5" />
		<circle cx="12" cy="12" r="4" />
		<circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
	</svg>
)}

{name === "star" && (
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
		<path d="M12 17.3l-5.4 3.2 1.4-6-4.6-4 6-.5L12 4l2.6 6 6 .5-4.6 4 1.4 6z" stroke-linejoin="round" />
	</svg>
)}

{name === "menu" && (
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
		<path d="M4 6h16M4 12h16M4 18h16" />
	</svg>
)}

{name === "close" && (
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
		<path d="M6 6l12 12M18 6L6 18" />
	</svg>
)}

{name === "beer" && (
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
		<path d="M6 8h9v11a2 2 0 01-2 2H8a2 2 0 01-2-2V8z" />
		<path d="M15 10h2a2 2 0 012 2v2a2 2 0 01-2 2h-2M6 8c0-2 1-4 3-4M9 4c1.5 0 2 1 3.5 1" />
	</svg>
)}

{name === "cocktail" && (
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
		<path d="M4 4h16l-8 9-8-9z" stroke-linejoin="round" />
		<path d="M12 13v7M8 20h8" />
	</svg>
)}

{name === "food" && (
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
		<path d="M4 10c0-3 3.5-6 8-6s8 3 8 6" />
		<path d="M3 10h18l-1.5 8a2 2 0 01-2 2h-11a2 2 0 01-2-2L3 10z" stroke-linejoin="round" />
	</svg>
)}

{name === "music" && (
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
		<circle cx="7" cy="18" r="2.5" />
		<circle cx="17" cy="16" r="2.5" />
		<path d="M9.5 18V6l10-2v12" />
	</svg>
)}

{name === "screen" && (
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
		<rect x="3" y="4" width="18" height="12" rx="1.5" />
		<path d="M8 20h8M12 16v4" />
	</svg>
)}

{name === "vinyl" && (
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
		<circle cx="11" cy="13" r="8" />
		<circle cx="11" cy="13" r="2.5" />
		<path d="M11 8a5 5 0 0 0-5 5M16 13a5 5 0 0 1-5 5" stroke-width="1" />
		<path d="M21 3l-1 8-3.5 3.5" stroke-linecap="round" stroke-linejoin="round" />
	</svg>
)}

{name === "cake" && (
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
		<path d="M4 20h16M5 20v-6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v6" stroke-linejoin="round" />
		<path d="M5 15.5c1.2 1 2.3 1 3.5 0s2.3-1 3.5 0 2.3 1 3.5 0 2.3-1 3.5 0" />
		<path d="M12 12V8.5M8 12V9.5M16 12V9.5" />
		<path d="M12 4.5c.8.8.8 1.8 0 2.3-.8-.5-.8-1.5 0-2.3z" stroke-width="1.2" />
	</svg>
)}

{name === "arrow-left" && (
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
		<path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round" />
	</svg>
)}

{name === "arrow-right" && (
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
		<path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
	</svg>
)}
