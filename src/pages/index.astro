---
export const prerender = false; // el middleware del gate necesita evaluar la fecha en cada petición
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Carta from "../components/Carta.astro";
import Galeria from "../components/Galeria.astro";
import Eventos from "../components/Eventos.astro";
import Visitanos from "../components/Visitanos.astro";
import Footer from "../components/Footer.astro";
import WhatsAppBubble from "../components/WhatsAppBubble.astro";
---

<html lang="es">
	<head>
		<SEO datosLocal />
	</head>
	<body class="bg-[var(--color-noche)] text-gray-200">
		<Header />
		<main>
			<Hero />
			<Carta />
			<Galeria />
			<Eventos />
			<Visitanos />
		</main>
		<Footer />
		<WhatsAppBubble />
	</body>
</html>
