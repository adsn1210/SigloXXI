---
export const prerender = false; // el middleware del gate necesita evaluar la fecha en cada petición
import "../styles/global.css";
import { site } from "../config/site.ts";
import SEO from "../components/SEO.astro";
import Marca from "../components/Marca.astro";
import NeonIcon from "../components/NeonIcon.astro";
---

<html lang="es">
	<head>
		<SEO titulo={`Página no encontrada · ${site.nombre}`} noindex />
	</head>
	<body class="bg-neon-glow flex min-h-screen flex-col items-center justify-center gap-6 px-6 py-20 text-center text-gray-200">
		<Marca class="items-center" />

		<p class="neon-text flicker [font-family:var(--font-titular)] text-8xl font-bold text-[var(--color-neon-cian)] lg:text-9xl">404</p>

		<h1 class="[font-family:var(--font-titular)] text-2xl uppercase tracking-wide text-[var(--color-neon-rosa)] lg:text-3xl">
			Esta página se fue de copas
		</h1>

		<p class="max-w-sm [font-family:var(--font-acento)] text-xl italic text-gray-300">
			No la encontramos, pero la barra sigue abierta.
		</p>

		<a href="/" class="neon-btn inline-flex items-center gap-2 rounded-md px-6 py-3 text-sm uppercase tracking-wide">
			<NeonIcon name="arrow-left" class="h-4 w-4" />
			Volver al inicio
		</a>
	</body>
</html>
