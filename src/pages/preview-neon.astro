---
export const prerender = false; // el middleware del gate necesita evaluar la fecha en cada petición
import "../styles/global.css";

// Iconos de línea provisionales para esta prueba — en Fase 2 pasan a src/components/NeonIcon.astro
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Preview — identidad neón</title>
	</head>
	<body class="bg-neon-glow min-h-screen [font-family:var(--font-cuerpo)] text-gray-200">
		<p class="border-b border-white/10 px-6 py-3 text-center text-[11px] uppercase tracking-widest text-gray-500">
			Vista previa de estilo — no es una página final
		</p>

		<!-- HERO -->
		<section class="mx-auto flex max-w-3xl flex-col items-start gap-6 px-6 py-24 lg:items-center lg:px-8 lg:py-32 lg:text-center">
			<div class="acento-oro inline-flex items-center gap-2 rounded-full border px-5 py-2 text-xs uppercase tracking-[0.25em] text-[var(--color-neon-oro)]">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
					<path d="M4 17l-1.4-8.5L8 12l4-7 4 7 5.4-3.5L20 17H4z" stroke-linejoin="round" />
					<path d="M4 17h16v2.5H4z" stroke-linejoin="round" />
				</svg>
				Taberna Siglo XXI
			</div>

			<h1 class="neon-text [font-family:var(--font-titular)] text-6xl leading-[0.95] text-[var(--color-neon-rosa)] lg:text-8xl">
				Gran Inauguración
			</h1>

			<div class="neon-text flex items-center gap-3 [font-family:var(--font-titular)] text-2xl tracking-wide text-[var(--color-neon-cian)] lg:text-3xl">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-6 w-6">
					<rect x="3" y="5" width="18" height="16" rx="2" />
					<path d="M3 10h18M8 3v4M16 3v4" />
				</svg>
				03 de octubre 2026
			</div>

			<p class="[font-family:var(--font-brocha)] text-3xl text-[var(--color-neon-oro)]">
				Buen ambiente
			</p>

			<div class="flex flex-wrap gap-4 pt-6 lg:justify-center">
				<button class="neon-btn inline-flex items-center gap-2 rounded-md px-6 py-3 text-sm uppercase tracking-wide">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
						<path d="M12 21s7-7.5 7-12a7 7 0 10-14 0c0 4.5 7 12 7 12z" />
						<circle cx="12" cy="9" r="2.5" />
					</svg>
					Cómo llegar
				</button>
				<button class="acento-oro inline-flex items-center gap-2 rounded-md border px-6 py-3 text-sm uppercase tracking-wide text-[var(--color-neon-oro)]">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
						<path d="M21 15a2 2 0 01-2 2H8l-4 4V5a2 2 0 012-2h13a2 2 0 012 2z" />
					</svg>
					WhatsApp
				</button>
			</div>
		</section>

		<!-- TARJETA + CITA -->
		<section class="mx-auto grid max-w-5xl gap-10 px-6 py-24 lg:grid-cols-2 lg:px-8 lg:py-32">
			<div class="neon-box acento-oro rounded-lg p-8">
				<h2 class="mb-3 [font-family:var(--font-titular)] text-2xl tracking-wide text-[var(--color-neon-violeta)]">
					Celebra con nosotros
				</h2>
				<p class="text-sm leading-relaxed text-gray-400">
					Cumpleaños · Despedidas · Empresa · Partidos
				</p>
				<p class="mt-6 [font-family:var(--font-acento)] text-3xl italic text-[var(--color-neon-oro)]">
					Copa de la casa — 6€
				</p>
			</div>

			<blockquote class="flex items-center border-l-2 border-[var(--color-neon-oro)] pl-8 [font-family:var(--font-acento)] text-3xl italic leading-snug text-gray-300">
				Un rincón con acento propio, en el corazón de Parla.
			</blockquote>
		</section>

		<footer class="border-t border-white/10 px-6 py-10 text-center text-[11px] text-gray-600">
			rosa #ff2d95 · cian #22d3ee · violeta #a855f7 · oro #ffc93c — fondo con degradado, no plano
		</footer>
	</body>
</html>
