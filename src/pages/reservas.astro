---
export const prerender = false; // el middleware del gate necesita evaluar la fecha en cada petición
import "../styles/global.css";
import { site } from "../config/site.ts";
import NeonIcon from "../components/NeonIcon.astro";
import WhatsAppBubble from "../components/WhatsAppBubble.astro";
import SEO from "../components/SEO.astro";
import Marca from "../components/Marca.astro";
---

<html lang="es">
	<head>
		<SEO
			titulo={`Reservas y eventos · ${site.nombre}, Parla`}
			descripcion={`Reserva ${site.nombre} para tu cumpleaños, sesión de DJ, despedida o evento de empresa en Parla. Local completo o zona reservada. Escríbenos por WhatsApp.`}
		/>
	</head>
	<body class="bg-neon-glow flex min-h-screen flex-col items-center justify-center gap-6 px-6 py-20 text-center text-gray-200">
		<Marca class="items-center" />

		<h1 class="neon-text [font-family:var(--font-titular)] text-4xl text-[var(--color-neon-rosa)] lg:text-6xl">
			Reservas de eventos
		</h1>

		<p class="max-w-md [font-family:var(--font-acento)] text-xl italic text-gray-300">
			Cumpleaños, sesiones de DJ, despedidas o eventos de empresa: cuéntanos la fecha y
			lo que necesitas por WhatsApp y te contestamos directamente.
		</p>

		<a href={site.contacto.whatsappUrl} target="_blank" rel="noopener noreferrer" class="neon-btn inline-flex items-center gap-2 rounded-md px-6 py-3 text-sm uppercase tracking-wide">
			<NeonIcon name="whatsapp" class="h-4 w-4" />
			Escribir por WhatsApp
		</a>

		<a href="/" class="mt-4 text-sm text-gray-500 underline underline-offset-4">Volver al inicio</a>

		<WhatsAppBubble />
	</body>
</html>
